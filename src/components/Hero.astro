---
import { hero, profile } from '../data/content';
---
<header id="top">
  <canvas id="hero3d" aria-hidden="true"></canvas>
  <div class="hero-inner wrap">
    <div class="eyebrow mono" style="border:none;padding:0;">
      {hero.eyebrow.map((e) => <span class="tag">{e}</span>)}
    </div>
    <h1 class="display">
      <span class="glitch" data-text={hero.lead}>{hero.lead}</span>
    </h1>
    <p class="sub">{hero.sub}</p>
    <div class="cta">
      <a class="btn btn-solid" href={`mailto:${profile.email}`}>Get in touch</a>
      <a class="btn btn-ghost" href={profile.resume} target="_blank" rel="noopener">Resume</a>
    </div>
    <a class="scrollcue mono" href="#approach">Scroll to think out loud</a>
  </div>
</header>

<style>
  header { position: relative; min-height: 100svh; display: flex; align-items: center; overflow: hidden; }
  #hero3d {
    position: absolute; inset: 0; width: 100%; height: 100%; z-index: 0;
    /* radial vignette so text stays legible over the point cloud */
    mask-image: radial-gradient(ellipse 70% 70% at 65% 45%, #000 40%, transparent 78%);
    -webkit-mask-image: radial-gradient(ellipse 70% 70% at 65% 45%, #000 40%, transparent 78%);
  }
  .hero-inner { position: relative; z-index: 1; padding-top: 96px; width: 100%; }
  .eyebrow { display: flex; flex-wrap: wrap; gap: 8px 20px; color: var(--dim); margin-bottom: 30px; }
  .tag { position: relative; }
  .tag:not(:last-child)::after { content: '·'; margin-left: 20px; color: var(--faint); }
  h1 {
    font-size: clamp(52px, 11vw, 148px);
    line-height: 0.98; font-weight: 700; letter-spacing: -0.035em;
    max-width: 14ch;
  }
  .glitch::selection { background: var(--accent); color: var(--ink); }
  .sub { max-width: 60ch; margin-top: 28px; color: var(--dim); font-size: clamp(16px, 1.8vw, 20px); }
  .sub { font-weight: 300; }
  .cta { display: flex; gap: 14px; margin-top: 36px; flex-wrap: wrap; }
  .scrollcue { display: inline-block; margin-top: 54px; color: var(--dim); transition: color 0.2s; }
  .scrollcue:hover { color: var(--accent); }
</style>

<script>
  import { initHero3D } from '../scripts/hero3d';
  const start = () => initHero3D('hero3d');
  if ('requestIdleCallback' in window) requestIdleCallback(start, { timeout: 1200 });
  else setTimeout(start, 300);
</script>
