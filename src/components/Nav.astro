---
import { profile } from '../data/content';
---
<nav>
  <a href="#top" class="brand display">Aman Banthia<i>_</i></a>
  <div class="links mono">
    <a href="#approach">Approach</a>
    <a href="#work">Work</a>
    <a href="#experience">Experience</a>
    <a href="#education">Education</a>
    <a href="#skills">Capabilities</a>
  </div>
  <a class="pill mono" href={`mailto:${profile.email}`}>Get in touch</a>
</nav>

<style>
  nav {
    position: fixed; top: 0; left: 0; right: 0; z-index: 100;
    display: flex; align-items: center; justify-content: space-between; gap: 16px;
    padding: 16px var(--pad);
    background: color-mix(in oklab, var(--ink) 72%, transparent);
    backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--hair);
  }
  .brand { font-size: 15px; font-weight: 700; }
  .brand i { font-style: normal; color: var(--accent); }
  .links { display: flex; gap: 26px; color: var(--dim); }
  .links a { transition: color 0.2s; }
  .links a:hover { color: var(--paper); }
  .pill {
    border: 1px solid var(--faint); border-radius: 999px; padding: 9px 18px; color: var(--paper);
    transition: background 0.2s, color 0.2s, border-color 0.2s;
  }
  .pill:hover { background: var(--accent); color: var(--ink); border-color: var(--accent); }
  @media (max-width: 820px) { .links { display: none; } }
</style>
