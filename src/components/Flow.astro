---
// Architecture diagram as an auto-sizing HTML pipeline: nodes grow to fit their
// own text, connectors flex to fill, and a clean loop-back bar shows a cycle.
interface Props { name: string; }
const { name } = Astro.props;

type Node = { title: string; sub: string; hot?: boolean };
type FlowDef = { caption: string; loop?: string; nodes: Node[] };

const flows: Record<string, FlowDef> = {
  sampoorna: {
    caption: 'Agent speaks one voice note. The CRM fills itself.',
    nodes: [
      { title: 'Voice note', sub: 'any language' },
      { title: 'AI parser', sub: 'api / ai / chat', hot: true },
      { title: 'Lead update', sub: 'Supabase' },
      { title: 'Follow-up', sub: 'calendar + booking' },
      { title: 'Notify', sub: 'WhatsApp + tasks' },
    ],
  },
  trinetra: {
    caption: 'The model proposes. Deterministic logic decides. Every step is auditable.',
    nodes: [
      { title: 'Signal feed', sub: 'event replay' },
      { title: 'Re-score', sub: 'exposure graph' },
      { title: 'LLM proposer', sub: 'option cards', hot: true },
      { title: 'Critic + arbiter', sub: 'zero-LLM · deterministic', hot: true },
      { title: 'Audit trail', sub: 'hash-chained' },
    ],
  },
  casecompass: {
    caption: 'Every practice session sharpens the next one.',
    loop: 'personalizes the next session',
    nodes: [
      { title: 'Student', sub: 'case journeys' },
      { title: 'AI interviewer', sub: 'simulation', hot: true },
      { title: 'Telemetry', sub: 'engagement' },
      { title: 'Clustering', sub: 'percentile ranks' },
      { title: 'Personalized plan', sub: 'targets real gaps', hot: true },
    ],
  },
};

const f = flows[name];
---
{f && (
  <div class="flow">
    <div class="pipe">
      {f.nodes.map((n, i) => (
        <>
          <div class={`node${n.hot ? ' hot' : ''}`}>
            <span class="nt mono">{n.title}</span>
            <span class="ns mono">{n.sub}</span>
          </div>
          {i < f.nodes.length - 1 && (
            <div class="conn" aria-hidden="true"><span class="ln"></span><span class="ar">&rsaquo;</span></div>
          )}
        </>
      ))}
    </div>
    {f.loop && (
      <div class="loop" aria-hidden="true">
        <span class="ico">&#8635;</span>
        <span class="ln"></span>
        <span class="lbl mono">{f.loop}</span>
        <span class="ln"></span>
      </div>
    )}
    <p class="cap mono">{f.caption}</p>
  </div>
)}

<style>
  .flow {
    margin-top: 26px;
    border: 1px solid var(--faint);
    border-radius: 14px;
    background: var(--ink-2);
    overflow: hidden;
  }
  .pipe {
    display: flex;
    align-items: center;
    gap: 0;
    padding: 30px 26px;
    overflow-x: auto;
    background-image: radial-gradient(rgba(236, 233, 225, 0.05) 1px, transparent 1px);
    background-size: 22px 22px;
    scrollbar-width: thin;
  }
  .node {
    flex: 0 0 auto;
    display: flex;
    flex-direction: column;
    gap: 5px;
    padding: 14px 18px;
    border: 1px solid rgba(236, 233, 225, 0.14);
    border-radius: 10px;
    background: #141416;
    white-space: nowrap;
  }
  .node.hot {
    border-color: var(--accent);
    box-shadow: 0 0 0 1px rgba(200, 255, 77, 0.15), 0 0 24px -8px rgba(200, 255, 77, 0.4);
  }
  .nt { color: var(--paper); letter-spacing: 0.08em; font-size: 11px; }
  .ns { color: var(--dim); font-size: 9.5px; letter-spacing: 0.06em; text-transform: none; }
  .node.hot .nt { color: var(--accent); }

  .conn { flex: 1 1 auto; min-width: 40px; display: flex; align-items: center; }
  .conn .ln {
    flex: 1;
    height: 2px;
    background-image: linear-gradient(90deg, var(--accent) 0 6px, transparent 6px 13px);
    background-size: 13px 2px;
    opacity: 0.55;
    animation: flowdash 1.6s linear infinite;
  }
  .conn .ar { color: var(--accent); font-size: 16px; margin-left: 2px; opacity: 0.8; }
  @keyframes flowdash { to { background-position: 13px 0; } }

  .loop {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 0 30px 4px;
    margin-top: -6px;
  }
  .loop .ico { color: var(--accent); font-size: 15px; }
  .loop .ln {
    flex: 1;
    height: 1px;
    background-image: linear-gradient(90deg, rgba(200, 255, 77, 0.5) 0 5px, transparent 5px 11px);
    background-size: 11px 1px;
  }
  .loop .lbl { color: var(--dim); text-transform: none; letter-spacing: 0.06em; white-space: nowrap; }

  .cap {
    display: block;
    padding: 14px 26px 16px;
    color: var(--dim);
    border-top: 1px solid var(--faint);
    text-transform: none;
    letter-spacing: 0.04em;
  }

  @media (prefers-reduced-motion: reduce) { .conn .ln { animation: none; } }
</style>
