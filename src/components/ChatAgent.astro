---
// AI chat agent → Cloudflare Worker proxy → OpenRouter (free models).
// Voice conversation uses the browser's built-in Web Speech API (SpeechRecognition
// for speech-to-text, speechSynthesis for text-to-speech) — free, client-side, no key.
// OpenRouter has no TTS/STT endpoints, so the voice layer lives in the browser.
const AGENT_URL = 'https://aman-portfolio-agent.sampoornacrm.workers.dev/chat';
---
<button class="fab mono" id="chatFab" aria-label="Ask Aman's AI agent" aria-expanded="false" aria-controls="chatPanel">
  <span class="dot"></span>Ask AI
</button>

<div class="panel" id="chatPanel" role="dialog" aria-label="Aman's AI agent" inert>
  <div class="head">
    <span class="avatar mono">AB</span>
    <div>
      <div class="t">Aman's Agent</div>
      <div class="s mono">Ask, or talk to it</div>
    </div>
    <button class="ico-btn" id="voiceToggle" aria-label="Speak replies aloud" aria-pressed="false" title="Speak replies aloud" hidden>
      <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M4 9v6h4l5 4V5L8 9H4z"/><path class="wave" d="M16 8.5a5 5 0 0 1 0 7"/><path class="wave2" d="M18.5 6a8 8 0 0 1 0 12"/>
      </svg>
    </button>
    <button class="ico-btn x" id="chatClose" aria-label="Close chat">
      <svg width="14" height="14" viewBox="0 0 14 14" aria-hidden="true"><path d="M1 1l12 12M13 1L1 13" stroke="currentColor" stroke-width="1.5"/></svg>
    </button>
  </div>

  <div class="msgs" id="chatMsgs" aria-live="polite">
    <div class="msg bot">Hi. I am Aman's AI agent. Type a question, or tap the mic and talk to me. Turn on the speaker and I will answer out loud.</div>
  </div>

  <div class="chips" id="chatChips">
    <button>What could Aman do for my team?</button>
    <button>Show me his strongest AI product</button>
    <button>Why hire him for a PM role?</button>
  </div>

  <div class="input">
    <button class="ico-btn mic" id="chatMic" aria-label="Speak your question" aria-pressed="false" title="Speak your question" hidden>
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <rect x="9" y="2" width="6" height="12" rx="3"/><path d="M5 11a7 7 0 0 0 14 0M12 18v3"/>
      </svg>
    </button>
    <input id="chatText" type="text" maxlength="500" placeholder="Ask about Aman..." aria-label="Ask about Aman" autocomplete="off" />
    <button class="send" id="chatSend" aria-label="Send">
      <svg width="16" height="16" viewBox="0 0 16 16" aria-hidden="true"><path d="M1 8h12M8 3l5 5-5 5" stroke="currentColor" stroke-width="1.6" fill="none"/></svg>
    </button>
  </div>
</div>

<style>
  .fab {
    position: fixed; right: 22px; bottom: 22px; z-index: 300;
    display: inline-flex; align-items: center; gap: 9px;
    padding: 12px 20px; border-radius: 999px; cursor: pointer;
    background: var(--paper); color: var(--ink); border: none;
    box-shadow: 0 10px 30px rgba(0,0,0,0.4);
    transition: transform 0.25s var(--ease), background 0.2s;
  }
  .fab:hover { transform: translateY(-2px); background: var(--accent); }
  .fab .dot { width: 7px; height: 7px; border-radius: 50%; background: var(--ink); animation: blink 1.8s ease infinite; }
  @keyframes blink { 50% { opacity: 0.3; } }

  .panel {
    position: fixed; right: 22px; bottom: 84px; z-index: 300;
    width: min(384px, calc(100vw - 30px)); height: min(560px, 74vh);
    display: flex; flex-direction: column;
    background: color-mix(in oklab, var(--ink-2) 96%, transparent);
    backdrop-filter: blur(14px);
    border: 1px solid var(--faint); border-radius: 16px;
    box-shadow: 0 30px 80px rgba(0,0,0,0.6);
    opacity: 0; visibility: hidden; transform: translateY(16px) scale(0.97); pointer-events: none;
    transition: opacity 0.3s var(--ease), transform 0.3s var(--ease), visibility 0s linear 0.3s;
  }
  .panel.open { opacity: 1; visibility: visible; transform: none; pointer-events: auto; transition-delay: 0s; }

  .head { display: flex; align-items: center; gap: 10px; padding: 14px 16px; border-bottom: 1px solid var(--faint); }
  .avatar { width: 32px; height: 32px; border-radius: 50%; background: var(--accent); color: var(--ink); display: grid; place-items: center; font-weight: 600; font-size: 11px; flex: 0 0 auto; }
  .head .t { font-size: 13.5px; font-weight: 600; }
  .head .s { color: var(--dim); }
  .head > div:nth-child(2) { margin-right: auto; }

  .ico-btn { background: none; border: 1px solid transparent; color: var(--dim); cursor: pointer; display: grid; place-items: center; width: 32px; height: 32px; border-radius: 8px; transition: color 0.2s, border-color 0.2s, background 0.2s; }
  .ico-btn:hover { color: var(--paper); }
  #voiceToggle[aria-pressed="true"] { color: var(--accent); border-color: color-mix(in oklab, var(--accent) 40%, transparent); }
  #voiceToggle:not([aria-pressed="true"]) .wave, #voiceToggle:not([aria-pressed="true"]) .wave2 { opacity: 0.25; }
  .mic.on { color: var(--ink); background: var(--accent); border-color: var(--accent); animation: micpulse 1.2s ease infinite; }
  @keyframes micpulse { 0%,100% { box-shadow: 0 0 0 0 rgba(200,255,77,0.5); } 50% { box-shadow: 0 0 0 6px rgba(200,255,77,0); } }

  .msgs { flex: 1; overflow-y: auto; padding: 16px; display: flex; flex-direction: column; gap: 10px; }
  .msg { max-width: 86%; padding: 10px 14px; border-radius: 12px; font-size: 13.5px; line-height: 1.5; animation: msgin 0.35s var(--ease); }
  @keyframes msgin { from { opacity: 0; transform: translateY(8px); } }
  .msg.bot { align-self: flex-start; background: rgba(236,233,225,0.06); border: 1px solid var(--faint); border-bottom-left-radius: 4px; color: var(--text); }
  .msg.me { align-self: flex-end; background: rgba(200,255,77,0.1); border: 1px solid rgba(200,255,77,0.3); border-bottom-right-radius: 4px; }
  .msg.typing span { display: inline-block; width: 6px; height: 6px; border-radius: 50%; background: var(--dim); margin: 0 2px; animation: bounce 1.2s ease infinite; }
  .msg.typing span:nth-child(2) { animation-delay: 0.15s; }
  .msg.typing span:nth-child(3) { animation-delay: 0.3s; }
  @keyframes bounce { 30% { transform: translateY(-5px); } }

  .chips { display: flex; gap: 8px; padding: 0 16px 10px; flex-wrap: wrap; }
  .chips button { border: 1px solid var(--faint); background: none; color: var(--dim); cursor: pointer; border-radius: 999px; padding: 6px 12px; font-size: 11.5px; font-family: var(--font-body); transition: border-color 0.2s, color 0.2s; }
  .chips button:hover { border-color: var(--accent); color: var(--accent); }

  .input { display: flex; align-items: center; gap: 8px; padding: 12px 14px; border-top: 1px solid var(--faint); }
  .input input { flex: 1; min-width: 0; background: rgba(236,233,225,0.05); border: 1px solid var(--faint); border-radius: 999px; padding: 10px 16px; color: var(--paper); font-family: var(--font-body); font-size: 13.5px; outline: none; }
  .input input:focus { border-color: rgba(200,255,77,0.5); }
  .input .mic { flex: 0 0 auto; width: 38px; height: 38px; border-radius: 50%; border: 1px solid var(--faint); }
  .input .send { flex: 0 0 auto; width: 42px; height: 42px; border-radius: 50%; border: none; cursor: pointer; background: var(--paper); color: var(--ink); display: grid; place-items: center; transition: transform 0.2s, background 0.2s; }
  .input .send:hover { transform: scale(1.08); background: var(--accent); }

  @media (prefers-reduced-motion: reduce) { .mic.on { animation: none; } }
</style>

<script define:vars={{ AGENT_URL }}>
  const fab = document.getElementById('chatFab');
  const panel = document.getElementById('chatPanel');
  const msgs = document.getElementById('chatMsgs');
  const input = document.getElementById('chatText');
  const micBtn = document.getElementById('chatMic');
  const voiceBtn = document.getElementById('voiceToggle');
  const history = [];
  let busy = false;
  let voiceOn = false;      // speak replies aloud
  let listening = false;
  let lastViaVoice = false; // was the last question spoken? (drives hands-free loop)
  let voiceTurns = 0;       // consecutive spoken turns — capped so it can't run away

  /* ---------- open / close (with a11y) ---------- */
  function openPanel() {
    panel.classList.add('open');
    panel.inert = false;
    fab.setAttribute('aria-expanded', 'true');
    setTimeout(() => input.focus(), 60);
  }
  function closePanel() {
    panel.classList.remove('open');
    panel.inert = true;
    fab.setAttribute('aria-expanded', 'false');
    stopListening();
    voiceTurns = 0;
    if (window.speechSynthesis) window.speechSynthesis.cancel();
    fab.focus();
  }
  fab.addEventListener('click', () => (panel.classList.contains('open') ? closePanel() : openPanel()));
  document.getElementById('chatClose').addEventListener('click', closePanel);
  document.addEventListener('keydown', (e) => { if (e.key === 'Escape' && panel.classList.contains('open')) closePanel(); });

  const chips = document.getElementById('chatChips');
  chips.addEventListener('click', (e) => {
    if (e.target.tagName === 'BUTTON') send(e.target.textContent, false);
  });
  function renderChips(suggestions) {
    if (!Array.isArray(suggestions) || suggestions.length < 2) return;
    chips.textContent = '';
    for (const s of suggestions) {
      const b = document.createElement('button');
      b.textContent = s;
      chips.appendChild(b);
    }
  }
  document.getElementById('chatSend').addEventListener('click', () => send(input.value, false));
  input.addEventListener('keydown', (e) => { if (e.key === 'Enter' && !e.isComposing) send(input.value, false); });

  function addMsg(cls, text) {
    const d = document.createElement('div');
    if (cls === 'typing') { d.className = 'msg bot typing'; d.innerHTML = '<span></span><span></span><span></span>'; }
    else { d.className = 'msg ' + cls; d.textContent = text; }
    msgs.appendChild(d); msgs.scrollTop = msgs.scrollHeight;
    return d;
  }

  async function send(text, viaVoice) {
    text = (text || '').trim();
    if (!text || busy) return;
    busy = true; lastViaVoice = !!viaVoice;
    voiceTurns = viaVoice ? voiceTurns + 1 : 0;
    input.value = '';
    addMsg('me', text);
    history.push({ role: 'user', content: text });
    const typing = addMsg('typing');
    try {
      const res = await fetch(AGENT_URL, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ messages: history.slice(-10) }),
      });
      const data = await res.json();
      typing.remove();
      const reply = data.reply || data.error || 'Something went wrong. Email amanbanthia@gmail.com.';
      addMsg('bot', reply);
      if (data.reply) {
        history.push({ role: 'assistant', content: data.reply });
        renderChips(data.suggestions);
        if (voiceOn) speak(reply);
      }
    } catch {
      typing.remove();
      addMsg('bot', 'I cannot reach the agent right now. Email amanbanthia@gmail.com instead.');
    }
    busy = false;
  }

  /* ---------- text-to-speech (speechSynthesis) ---------- */
  const synth = window.speechSynthesis;
  function pickVoice() {
    const vs = synth.getVoices();
    return vs.find((v) => /en-IN/i.test(v.lang)) || vs.find((v) => /en-GB/i.test(v.lang))
      || vs.find((v) => /^en/i.test(v.lang)) || vs[0] || null;
  }
  function speak(text) {
    if (!synth) return;
    synth.cancel();
    const u = new SpeechSynthesisUtterance(text);
    const v = pickVoice(); if (v) u.voice = v;
    u.rate = 1.05; u.pitch = 1;
    // hands-free: after speaking a reply to a spoken question, listen again
    u.onend = () => { if (voiceOn && lastViaVoice && voiceTurns < 25 && recognition && panel.classList.contains('open')) startListening(); };
    synth.speak(u);
  }
  if (synth) {
    voiceBtn.hidden = false;
    voiceBtn.addEventListener('click', () => {
      voiceOn = !voiceOn;
      voiceBtn.setAttribute('aria-pressed', String(voiceOn));
      if (!voiceOn) synth.cancel();
    });
  }

  /* ---------- speech-to-text (SpeechRecognition) ---------- */
  const SR = window.SpeechRecognition || window.webkitSpeechRecognition;
  let recognition = null;
  if (SR) {
    micBtn.hidden = false;
    recognition = new SR();
    recognition.lang = 'en-IN';
    recognition.interimResults = false;
    recognition.maxAlternatives = 1;
    recognition.onresult = (e) => {
      const transcript = e.results[0][0].transcript;
      send(transcript, true);
    };
    recognition.onend = () => { listening = false; micBtn.classList.remove('on'); micBtn.setAttribute('aria-pressed', 'false'); };
    recognition.onerror = () => { listening = false; micBtn.classList.remove('on'); micBtn.setAttribute('aria-pressed', 'false'); };
    micBtn.addEventListener('click', () => (listening ? stopListening() : startListening()));
  }
  function startListening() {
    if (!recognition || listening) return;
    if (synth) synth.cancel();
    try { recognition.start(); listening = true; micBtn.classList.add('on'); micBtn.setAttribute('aria-pressed', 'true'); } catch { /* already started */ }
  }
  function stopListening() {
    if (!recognition || !listening) return;
    try { recognition.stop(); } catch {}
    listening = false; micBtn.classList.remove('on'); micBtn.setAttribute('aria-pressed', 'false');
  }
</script>
