---
import { caseStudies } from '../data/content';
import Flow from './Flow.astro';
---
<section id="work" class="wrap">
  <p class="eyebrow mono">Selected work</p>
  <h2 class="sec-title">Problems, and what I designed to solve them</h2>
  <p class="sec-sub">Each of these started as a business problem, not a brief to build something. The tech is downstream.</p>

  <div class="list">
    {caseStudies.map((c) => (
      <article class="cs reveal">
        <div class="head">
          <span class="mono yr">{c.year}</span>
          <a class="name display glitch" href={c.href} target="_blank" rel="noopener" data-text={c.name}>{c.name}<span class="ext" aria-hidden="true">&nearr;</span></a>
          <div class="tags">{c.tags.map((t) => <span class="mono">{t}</span>)}</div>
        </div>

        <div class={`body${c.shot ? '' : ' solo'}`}>
          {c.shot && (
            <a class="shot" href={c.href} target="_blank" rel="noopener" style={`--img:url(${c.shot})`} aria-label={`Open ${c.name}`}>
              <img src={c.shot} alt={`${c.name} screenshot`} loading="lazy" width="1280" height="800" />
              <span class="scan" aria-hidden="true"></span>
            </a>
          )}
          <div class="text">
            <div class="po"><span class="lab mono">Problem</span><p>{c.problem}</p></div>
            <div class="po"><span class="lab mono">Solution</span><p>{c.solution}</p></div>
            <div class="po"><span class="lab mono accent">Outcome</span><p>{c.outcome}</p></div>
          </div>
        </div>

        {c.flow && <Flow name={c.flow} />}
      </article>
    ))}
  </div>
</section>

<style>
  .list { margin-top: 54px; }
  .cs { padding: 56px 0; border-top: 1px solid var(--faint); }
  .cs:last-child { border-bottom: 1px solid var(--faint); }

  .head { display: flex; align-items: baseline; gap: 18px; flex-wrap: wrap; margin-bottom: 30px; }
  .yr { color: var(--dim); }
  .name { font-size: clamp(24px, 3.5vw, 40px); font-weight: 600; transition: color 0.2s; }
  .name .ext { font-size: 0.5em; vertical-align: super; margin-left: 4px; color: var(--accent); }
  .name:hover { color: var(--accent); }
  .tags { display: flex; gap: 8px; flex-wrap: wrap; margin-left: auto; }
  .tags span { border: 1px solid var(--faint); border-radius: 999px; padding: 4px 11px; color: var(--dim); }

  .body { display: grid; grid-template-columns: 1fr 0.92fr; gap: 44px; align-items: center; }
  .body.solo { grid-template-columns: 1fr; max-width: 78ch; }
  /* alternate the image side for editorial rhythm */
  .cs:nth-child(even) .body { grid-template-columns: 0.92fr 1fr; }
  .cs:nth-child(even) .shot { order: -1; }

  .text { display: flex; flex-direction: column; gap: 22px; }
  .po { display: grid; grid-template-columns: 92px 1fr; gap: 14px; align-items: start; }
  .lab { color: var(--dim); padding-top: 3px; }
  .lab.accent { color: var(--accent); }
  .po p { font-size: 15px; line-height: 1.65; color: var(--text); }

  /* ---- screenshot with RGB-split glitch on hover ---- */
  .shot {
    position: relative;
    display: block;
    border: 1px solid var(--faint);
    border-radius: 12px;
    overflow: hidden;
    background: var(--ink-2);
    aspect-ratio: 16 / 10;
  }
  .shot img { display: block; width: 100%; height: 100%; object-fit: cover; object-position: top center; transition: transform 0.4s var(--ease); }
  .shot::before, .shot::after {
    content: '';
    position: absolute; inset: 0;
    background: var(--img) center top / cover no-repeat;
    background-blend-mode: screen;
    mix-blend-mode: screen;
    opacity: 0;
    pointer-events: none;
  }
  .shot::before { background-color: #ff2f6e; }
  .shot::after { background-color: #2fe0ff; }
  .shot .scan {
    position: absolute; inset: 0; pointer-events: none; opacity: 0;
    background: repeating-linear-gradient(0deg, rgba(0,0,0,0.14) 0 1px, transparent 1px 3px);
    transition: opacity 0.2s;
  }
  .shot:hover img { transform: scale(1.02); }
  .shot:hover .scan { opacity: 1; }
  .shot:hover::before { opacity: 0.55; animation: imgGlitchA 0.42s steps(2, end) 2; }
  .shot:hover::after { opacity: 0.55; animation: imgGlitchB 0.42s steps(2, end) 2; }

  @keyframes imgGlitchA {
    0%, 100% { transform: translate(0, 0); clip-path: inset(0 0 0 0); }
    20% { transform: translate(-5px, 0); clip-path: inset(8% 0 62% 0); }
    45% { transform: translate(4px, 0); clip-path: inset(48% 0 22% 0); }
    70% { transform: translate(-3px, 0); clip-path: inset(28% 0 44% 0); }
    90% { transform: translate(3px, 0); clip-path: inset(72% 0 6% 0); }
  }
  @keyframes imgGlitchB {
    0%, 100% { transform: translate(0, 0); clip-path: inset(0 0 0 0); }
    25% { transform: translate(5px, 0); clip-path: inset(58% 0 12% 0); }
    50% { transform: translate(-4px, 0); clip-path: inset(18% 0 52% 0); }
    75% { transform: translate(4px, 0); clip-path: inset(38% 0 34% 0); }
    95% { transform: translate(-3px, 0); clip-path: inset(80% 0 4% 0); }
  }

  @media (max-width: 860px) {
    .body, .cs:nth-child(even) .body { grid-template-columns: 1fr; gap: 26px; }
    .cs:nth-child(even) .shot { order: 0; }
    .tags { margin-left: 0; width: 100%; }
    .po { grid-template-columns: 78px 1fr; }
  }
  @media (prefers-reduced-motion: reduce) {
    .shot:hover::before, .shot:hover::after { animation: none; opacity: 0.4; }
    .shot:hover img { transform: none; }
  }
</style>
